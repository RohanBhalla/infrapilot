# Local development only. The deployed site reads /config.json, which `cdk deploy` writes (see infra/).
# Get the values from the InfraPilotChat stack outputs. Copy to .env.local (git-ignored).
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-app-client-id
VITE_COGNITO_DOMAIN=https://infrapilot-<account-id>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URL=http://localhost:5173
VITE_COGNITO_SIGN_OUT_URL=http://localhost:5173
# API Gateway URL from the stack outputs, or leave unset to use the local FastAPI app (http://127.0.0.1:8000)
VITE_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
