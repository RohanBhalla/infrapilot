# Copy to .env (git-ignored) and fill in. Real environment variables take precedence.

# Answer model (rag/). Embeddings stay on Amazon Titan V2 via AWS credentials.
OPENAI_API_KEY=
# INFRAPILOT_ANSWER_MODEL=gpt-5-mini        # or gpt-5, gpt-4.1-mini, nova-pro (Bedrock, no key)
# INFRAPILOT_REASONING_EFFORT=low           # minimal | low | medium | high (gpt-5 family)

# AWS: usually from ~/.aws/credentials; set here only to override.
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# Data collection: GitHub API rate limit goes from 60 to 5,000 requests/hour with a token.
# GITHUB_TOKEN=
